{
  "name": "job-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter cv-proof dev",
    "generate-cv": "tsx src/cli.ts generate-cv",
    "poll-email": "tsx src/cli.ts poll-email",
    "print-gmail-query": "tsx src/cli.ts print-gmail-query",
    "typecheck": "tsc --noEmit && pnpm --filter cv-proof typecheck",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "google-auth-library": "^11.0.2",
    "googleapis": "^178.0.0",
    "marked": "^18.0.11",
    "playwright": "^1.63.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  }
}
